# Copy to .env and fill in. Keep .env private (chmod 600).

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# The hostname you'll use in NPM+, e.g. crm.yourdomain.net
DJANGO_ALLOWED_HOSTS=crm.yourdomain.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.yourdomain.net

# Leave as 1 when NPM+ serves the site over HTTPS (recommended). Set 0 only for plain-HTTP testing.
DJANGO_HTTPS=1

# Unraid's nobody:users, so files in appdata get the usual ownership.
PUID=99
PGID=100

# Name of the Docker network NPM+ is attached to (docker network ls).
PROXY_NETWORK=proxynet
