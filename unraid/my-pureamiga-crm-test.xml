<?xml version="1.0"?>
<Container version="2">
  <Name>pureamiga-crm-test</Name>
  <Repository>ghcr.io/thepillock/pureamiga-crm:test</Repository>
  <Registry>https://github.com/thepillock/pureamiga-crm/pkgs/container/pureamiga-crm</Registry>
  <Network>proxynet</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/thepillock/pureamiga-crm</Support>
  <Project>https://github.com/thepillock/pureamiga-crm</Project>
  <Overview>Pure Amiga repairs CRM (TEST - tracks main branch). No ports are published: reach it through NPM+ at http://pureamiga-crm-test:8000 on the proxy network.</Overview>
  <Category>Productivity:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--read-only --tmpfs /tmp --security-opt no-new-privileges:true --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --cap-add SETUID --cap-add SETGID</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/pureamiga-crm-test" Mode="rw" Description="SQLite database and backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pureamiga-crm-test</Config>
  <Config Name="Secret key" Target="DJANGO_SECRET_KEY" Default="" Mode="" Description="Long random string, different for test and live" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Hostname" Target="DJANGO_ALLOWED_HOSTS" Default="crm-test.yourdomain.net" Mode="" Description="Hostname used in NPM+" Type="Variable" Display="always" Required="true" Mask="false">crm-test.yourdomain.net</Config>
  <Config Name="Trusted origin" Target="DJANGO_CSRF_TRUSTED_ORIGINS" Default="https://crm-test.yourdomain.net" Mode="" Description="https:// plus the hostname" Type="Variable" Display="always" Required="true" Mask="false">https://crm-test.yourdomain.net</Config>
  <Config Name="Environment label" Target="CRM_ENVIRONMENT" Default="test" Mode="" Description="Shows a banner when set (e.g. test). Leave empty for live." Type="Variable" Display="always" Required="false" Mask="false">test</Config>
  <Config Name="HTTPS" Target="DJANGO_HTTPS" Default="1" Mode="" Description="1 when NPM+ serves HTTPS" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
